{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug with tests",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/out/codex-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "mingw-debug",
      "displayName": "MinGW Release with tests",
      "binaryDir": "${sourceDir}/out/codex-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "qt-mingw-debug",
      "displayName": "Qt 6.10.3 / MinGW 13.1 Debug",
      "inherits": "mingw-debug",
      "binaryDir": "${sourceDir}/out/qt-debug",
      "environment": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/6.10.3/mingw_64/bin;$penv{PATH}",
        "QT_PLUGIN_PATH": "C:/Qt/6.10.3/mingw_64/plugins"
      },
      "cacheVariables": {
        "NAVIER_BUILD_GUI": "ON",
        "CMAKE_C_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.10.3/mingw_64"
      }
    },
    {
      "name": "qt-mingw-release",
      "displayName": "Qt 6.10.3 / MinGW 13.1 Release",
      "inherits": "qt-mingw-debug",
      "binaryDir": "${sourceDir}/out/qt-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
    { "name": "qt-mingw-debug", "configurePreset": "qt-mingw-debug" },
    { "name": "qt-mingw-release", "configurePreset": "qt-mingw-release" }
  ],
  "testPresets": [
    {
      "name": "mingw-debug", "configurePreset": "mingw-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "mingw-release", "configurePreset": "mingw-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "qt-mingw-debug", "configurePreset": "qt-mingw-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "qt-mingw-release", "configurePreset": "qt-mingw-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
